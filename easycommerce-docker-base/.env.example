```dotenv
# ==========================================
# EASYCOMMERCE
# ==========================================
APP_PORT=8081

# ==========================================
# POSTGRESQL
# ==========================================
POSTGRES_DB=easyecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DB_PORT=5432

# ==========================================
# PGADMIN
# ==========================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@easycommerce.com
PGADMIN_PASSWORD=your_pgadmin_password

# ==========================================
# JIRA SOFTWARE
# ==========================================
JIRA_PORT=8080
JIRA_DB_NAME=jira
JIRA_DB_USER=jira
JIRA_DB_PASSWORD=your_jira_password

# ==========================================
# N8N
# ==========================================
N8N_PORT=5678
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=replace_with_a_long_random_encryption_key

# ==========================================
# TIMEZONE
# ==========================================
TZ=America/Argentina/Jujuy
GENERIC_TIMEZONE=America/Argentina/Jujuy

# ==========================================
# PROMETHEUS
# ==========================================
PROMETHEUS_PORT=9090

# ==========================================
# GRAFANA
# ==========================================
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password

# ==========================================
# SPRING BOOT
# ==========================================
SQL_INIT_MODE=always
```