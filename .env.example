# --- APP ---
APP_PORT=8081
FRONT_PORT=8082
SQL_INIT_MODE=never

# --- POSTGRESQL ---
POSTGRES_DB=easyecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esto
DB_PORT=5433

# --- PGADMIN ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@easycommerce.com
PGADMIN_PASSWORD=cambiar_esto

# --- JIRA ---
JIRA_PORT=8080
JIRA_DB_NAME=jira
JIRA_DB_USER=jira
JIRA_DB_PASSWORD=cambiar_esto

# --- N8N ---
DB_PORT=5433
N8N_VERSION=2.42.7   # mirar hub.docker.com/r/n8nio/n8n
N8N_HOST=localhost
N8N_PUBLIC_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=cambiar_por_clave_larga_aleatoria

# --- PROMETHEUS / GRAFANA ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambiar_esto

# --- TUNEL (solo para el deploy) ---
CLOUDFLARED_VERSION=poner_version_fija
TUNNEL_TOKEN=

# --- ZONA HORARIA ---
TZ=America/Argentina/Jujuy
GENERIC_TIMEZONE=America/Argentina/Jujuy